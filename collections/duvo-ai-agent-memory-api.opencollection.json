{
  "opencollection": "1.0.0",
  "info": {
    "name": "Duvo Public Agent Folders Agent Memory API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Agent Memory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Agent Memory Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/memory/files",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The agent's unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the memory files stored for an agent."
        },
        {
          "info": {
            "name": "Get Agent Memory File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/memory/files/:*",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The agent's unique identifier"
              },
              {
                "name": "*",
                "value": "",
                "type": "path",
                "description": "Relative path to the memory file, e.g. notes.md or context/customer.md"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the contents of a single memory file for an agent."
        }
      ]
    }
  ],
  "bundled": true
}