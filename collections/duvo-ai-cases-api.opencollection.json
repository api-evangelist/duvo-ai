          "http": {
            "method": "GET",
            "url": "https://api.duvo.ai/v2/queues/:queue_id/cases/:case_id/labels",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of labels to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset for pagination."
              },
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The queue's unique identifier"
              },
              {
                "name": "case_id",
                "value": "",
                "type": "path",
                "description": "The case's unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all labels assigned to a case."
        },
        {
          "info": {
            "name": "Assign Case Labels",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duvo.ai/v2/queues/:queue_id/cases/:case_id/labels",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The queue's unique identifier"
              },
              {
                "name": "case_id",
                "value": "",
                "type": "path",
                "description": "The case's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Assign one or more labels to a case. Creates the labels on the queue if they don't already exist."
        },
