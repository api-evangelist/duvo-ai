        },
        {
          "info": {
            "name": "Create Queue Label",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duvo.ai/v2/queues/:queue_id/labels",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The queue's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
