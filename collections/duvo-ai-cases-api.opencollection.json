            "url": "https://api.duvo.ai/v2/queues/:queue_id/cases/:case_id/labels/unlink",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path",
                "description": "The queue's unique identifier"
              },
              {
                "name": "case_id",
                "value": "",
                "type": "path",
                "description": "The case's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove the given labels from a case."
        },
        {
          "info": {
            "name": "Update Queue Label",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.duvo.ai/v2/queues/:queue_id/labels/:label_id",
            "params": [
