{
  "opencollection": "1.0.0",
  "info": {
    "name": "Duvo Public Agent Folders Schedules API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Agent Schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/schedules",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The agent's unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all schedules configured for an agent. Returns the schedules you own on this agent."
        },
        {
          "info": {
            "name": "Create Schedule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/schedules",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The agent's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a schedule for an agent. The schedule fires against the agent's live build. The authenticated user owns the schedule."
        },
        {
          "info": {
            "name": "Update Schedule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/schedules/:schedule_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The agent's unique identifier"
              },
              {
                "name": "schedule_id",
                "value": "",
                "type": "path",
                "description": "The schedule's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update fields on an existing schedule. Only supplied fields are changed; omitted fields retain their current values. Owners may update their own schedules; team superadmins may update any schedule on agents in the current team."
        },
        {
          "info": {
            "name": "Delete Schedule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/schedules/:schedule_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The agent's unique identifier"
              },
              {
                "name": "schedule_id",
                "value": "",
                "type": "path",
                "description": "The schedule's unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a schedule. Owners may delete their own schedules; team superadmins may delete any schedule on agents in the current team."
        }
      ]
    }
  ],
  "bundled": true
}