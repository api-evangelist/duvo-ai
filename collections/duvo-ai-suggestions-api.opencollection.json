{
  "opencollection": "1.0.0",
  "info": {
    "name": "Duvo Public Agent Folders Suggestions API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Suggestions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Agent Suggestions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duvo.ai/v2/agents/:agent_id/suggestions",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "The Agent's unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List an Agent's suggestions. status=pending is the inbox; status=history is consumed/dismissed/auto-cleared. Reads lazily auto-clear stale pending items."
        },
        {
          "info": {
            "name": "Consume Agent Suggestion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duvo.ai/v2/agents/suggestions/:id/consume",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The suggestion's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Apply a suggestion: stage its change into the Agent's draft revision, then auto-clear any pending suggestions it makes moot."
        },
        {
          "info": {
            "name": "Reject Agent Suggestion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duvo.ai/v2/agents/suggestions/:id/reject",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The suggestion's unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Dismiss a pending suggestion."
        }
      ]
    }
  ],
  "bundled": true
}